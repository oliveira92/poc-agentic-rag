# ============================================================
# Copie para .env e preencha. NUNCA versione o .env real.
# Carregado automaticamente no boot (DotenvEnvironmentPostProcessor) — sem `source`.
# Variáveis reais do ambiente / -D têm precedência sobre este arquivo.
# ============================================================

# --- Chat model (Anthropic Claude) ---
# Sem esta chave (com créditos), ingestão/recuperação funcionam, mas o /advise falha.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Use um id EXATO da sua conta (GET /v1/models). Com Spring AI 2.0 a família Claude 5
# funciona (não força mais 'temperature'):
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# --- Banco (pgvector) ---
DB_URL=jdbc:postgresql://localhost:5432/ragdb
DB_USERNAME=rag
DB_PASSWORD=rag

# --- Portal de componentes (Anti-Corruption Layer) ---
# perfil "mock" ignora estas variáveis e usa dados fake.
COMPONENT_PORTAL_BASE_URL=https://portal.suaempresa.com/api
COMPONENT_PORTAL_TOKEN=

# --- Langfuse v3 (observabilidade via OTLP) ---
# Passos: 1) docker compose --profile observability up -d
#         2) abra http://localhost:3000, crie conta + organização + projeto
#         3) copie as chaves do projeto e cole abaixo (o base64 do header é feito pela app)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_BASE_URL="http://localhost:3000"
