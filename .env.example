# ============================================================
# Copie para .env e preencha. NUNCA versione o .env real.
# Carregado automaticamente no boot (DotenvEnvironmentPostProcessor) — sem `source`.
# Variáveis reais do ambiente / -D têm precedência sobre este arquivo.
# ============================================================

# --- Gateway de modelos: LiteLLM (padrão, multi-provedor) ---
# Suba com: docker compose --profile llm up -d litellm
# A app só conhece a MASTER KEY do proxy; as chaves dos vendors ficam no container do LiteLLM.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-dev
LITELLM_MASTER_KEY=sk-local-dev
# Alias publicado no litellm/config.yaml (NÃO é o id do vendor).
LITELLM_CHAT_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=16384

# --- Chaves dos provedores (consumidas SÓ pelo container do LiteLLM) ---
# Preencha as que você tem; o proxy sobe mesmo com as outras vazias.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Fallback sem gateway: falar direto com a Anthropic (caminho da Fase 1) ---
# Para voltar a ele, troque as TRÊS linhas abaixo — a terceira é fácil de esquecer: sem ela a
# descoberta de modelos continuaria batendo em localhost:4000 (que não vai estar de pé).
#   APP_LLM_PROVIDER=anthropic
#   APP_MODELS_PROVIDER=anthropic
#   APP_MODELS_BASE_URL=https://api.anthropic.com
APP_LLM_PROVIDER=openai
APP_MODELS_PROVIDER=litellm
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# --- Segurança (M04) ---
# lexical = determinístico, roda sem chave (default da demo). llm = juiz que entende a base.
APP_SECURITY_SCOPE_JUDGE=lexical
# closed = falha de controle bloqueia. Só desligue 'enabled' para medir a linha de base.
APP_SECURITY_FAIL_MODE=closed
APP_SECURITY_ENABLED=true

# --- Banco (pgvector) ---
DB_URL=jdbc:postgresql://localhost:5432/ragdb
DB_USERNAME=rag
DB_PASSWORD=rag

# --- Portal de componentes (Anti-Corruption Layer) ---
# perfil "mock" ignora estas variáveis e usa dados fake.
COMPONENT_PORTAL_BASE_URL=https://portal.suaempresa.com/api
COMPONENT_PORTAL_TOKEN=

# --- Langfuse v3 (observabilidade via OTLP) ---
# Passos: 1) docker compose --profile observability up -d
#         2) abra http://localhost:3000, crie conta + organização + projeto
#         3) copie as chaves do projeto e cole abaixo (o base64 do header é feito pela app)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_BASE_URL="http://localhost:3000"

# ---------- Embeddings ----------
# PADRÃO: pelo gateway LiteLLM (nenhum modelo no processo, boot ~3s, sem download).
# Só precisa do proxy de pé e da chave do vendor DENTRO dele — a app não vê credencial.
LITELLM_EMBEDDING_MODEL=text-embedding-3-small

# FALLBACK offline: modelo ONNX local. Use quando não houver chave/gateway, o texto não puder
# sair da rede, ou em CI. Custa recall medido (quantização) — ver ADR-0009.
# Antes da primeira subida neste modo: ./scripts/prefetch-embeddings.sh
# APP_EMBEDDING_PROVIDER=transformers

# Onde o modelo local fica. NUNCA aponte para /tmp: é o default do Spring AI e é justamente o
# que fazia o download se repetir a cada boot frio (o macOS purga, o contêiner não tem).
EMBEDDING_CACHE_DIR=${HOME}/.cache/agentic-rag/onnx

# true = cache frio vira erro com o comando de correção, em vez de um boot de ~11 minutos.
# Ligue em CI e em contêiner. Em máquina de dev, deixe false para o primeiro boot funcionar.
EMBEDDING_REQUIRE_LOCAL=false

# Mirror interno (Nexus/Artifactory/S3) em vez do HuggingFace. É só um arquivo por HTTP.
# EMBEDDING_MODEL_URL=https://artifacts.suaempresa.com/onnx/model_quantized.onnx
# EMBEDDING_TOKENIZER_URL=https://artifacts.suaempresa.com/onnx/tokenizer.json

# Trocar QUALQUER backend de embedding exige reingerir a base: vetores de modelos diferentes
# não são comparáveis, mesmo com a mesma dimensão. O app.embedding.model-id força isso sozinho.
