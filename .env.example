# ============================================================
# Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================

# --- Chat model (Anthropic Claude) ---
# Sem esta chave, ingestão/recuperação funcionam, mas o endpoint de "advisor" falha.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Ajuste para o id de modelo público mais recente da sua conta (ex.: claude-sonnet-5)
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# --- Banco (pgvector) ---
DB_URL=jdbc:postgresql://localhost:5432/ragdb
DB_USERNAME=rag
DB_PASSWORD=rag

# --- Portal de componentes (Anti-Corruption Layer) ---
# perfil "mock" ignora estas variáveis e usa dados fake.
COMPONENT_PORTAL_BASE_URL=https://portal.suaempresa.com/api
COMPONENT_PORTAL_TOKEN=

# --- Langfuse (observabilidade via OTLP) ---
# Endpoint OTLP do Langfuse. Auth via Basic base64(public_key:secret_key).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(pk:sk)>
